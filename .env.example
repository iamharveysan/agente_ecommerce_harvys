# Clave de la API de OpenAI (obligatoria)
OPENAI_API_KEY=
# Modelo a usar (opcional). Equilibrado en calidad y costo:
OPENAI_MODEL=gpt-6.1-sol
# Esfuerzo de razonamiento: low | medium | high (opcional)
OPENAI_REASONING=medium
# Código de acceso para la clase (opcional, recomendado al publicar)
